{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Nao emitimos JS: o Vite cuida da transpilacao. tsc so verifica tipos. */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    /* Rigor: erros aqui sao erros de verdade, nao ruido. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    /* Forca tratar acesso por indice como possivelmente undefined:
       pega bugs de array/record antes de virarem crash em producao. */
    "noUncheckedIndexedAccess": true,

    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
